APP_ENV=production
HTTP_ADDR=:8080

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

MIGRATIONS_DIR=/app/migrations

POSTGRES_HOST=gamidoc-backend-prod-pg
POSTGRES_PORT=5432
POSTGRES_DB=gamidoc
POSTGRES_USER=gamidoc
POSTGRES_PASSWORD=change-this-password
POSTGRES_SSLMODE=require

REDIS_HOST=gamidoc-backend-prod-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_TTL=168h

SESSION_TTL=48h

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_PUBLIC_BASE_URL=/files/pdfs
OBJECT_STORAGE_LOCAL_ROOT_DIR=/app/.localdata/pdfs
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=auto
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
OBJECT_STORAGE_S3_USE_PATH_STYLE=false

MAILER_PROVIDER=noop
MAILER_FROM_EMAIL=
MAILER_FROM_NAME=GamiDoc
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com

PDF_HTML_RENDERER_URL=http://gamidoc-backend-prod-gotenberg:3000/forms/chromium/convert/html
PDF_HTML_RENDERER_TIMEOUT=30s

RECOMMENDATION_RULES_PATH=/app/rule/recommendations.json
